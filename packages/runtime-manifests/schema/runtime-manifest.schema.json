{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/soomin-kevin-sung/local-llm-wiki/runtime-manifest.schema.json",
  "title": "Local LLM Wiki runtime manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseVersion", "minimumAppVersion", "maximumAppVersion", "abiMajor", "abiMinor", "llamaCppCommit", "packs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "releaseVersion": { "type": "string", "minLength": 1 },
    "minimumAppVersion": { "type": "string", "minLength": 1 },
    "maximumAppVersion": { "type": "string", "minLength": 1 },
    "abiMajor": { "type": "integer", "minimum": 1 },
    "abiMinor": { "type": "integer", "minimum": 0 },
    "llamaCppCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "backend", "platform", "arch", "assetUrl", "size", "sha256", "files"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
          "backend": { "enum": ["cpu", "cuda", "vulkan"] },
          "platform": { "const": "windows" },
          "arch": { "const": "x86_64" },
          "assetUrl": { "type": "string", "format": "uri" },
          "size": { "type": "integer", "minimum": 1 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "size", "sha256"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "size": { "type": "integer", "minimum": 1 },
                "sha256": { "$ref": "#/$defs/sha256" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
  }
}
