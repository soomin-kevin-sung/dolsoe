root ::= final | tool-call

final ::= "{" ws "\"type\"" ws ":" ws "\"final\"" ws "," ws "\"content\"" ws ":" ws string ws "}"
tool-call ::= calculator-call | list-files-call | read-file-call | search-files-call | get-file-info-call

calculator-call ::= tool-prefix "\"calculator\"" arguments-prefix "{" ws "\"expression\"" ws ":" ws string ws "}" ws "}"
list-files-call ::= tool-prefix "\"list_files\"" arguments-prefix "{" ws "\"path\"" ws ":" ws string ws "}" ws "}"
read-file-call ::= tool-prefix "\"read_file\"" arguments-prefix "{" ws "\"path\"" ws ":" ws string (ws "," ws "\"offset\"" ws ":" ws integer ws "," ws "\"limit\"" ws ":" ws integer)? ws "}" ws "}"
search-files-call ::= tool-prefix "\"search_files\"" arguments-prefix "{" ws "\"query\"" ws ":" ws string ws "," ws "\"path\"" ws ":" ws string ws "}" ws "}"
get-file-info-call ::= tool-prefix "\"get_file_info\"" arguments-prefix "{" ws "\"path\"" ws ":" ws string ws "}" ws "}"

tool-prefix ::= "{" ws "\"type\"" ws ":" ws "\"tool_call\"" ws "," ws "\"name\"" ws ":" ws
arguments-prefix ::= ws "," ws "\"arguments\"" ws ":" ws
integer ::= [0-9]+

string ::= "\"" char* "\""
char ::= [^"\\\x00-\x1F] | "\\" (["\\/bfnrt] | "u" hex hex hex hex)
hex ::= [0-9a-fA-F]
ws ::= [ \t\n\r]*
